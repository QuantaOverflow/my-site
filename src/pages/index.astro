---
import Base from '../layouts/Base.astro';

const articles = Object.entries(import.meta.glob('./writing/*.md', { eager: true }))
  .map(([path, article]) => ({
    href: `/writing/${path.split('/').pop()?.replace(/\.md$/, '')}`,
    title: article.frontmatter.title,
    date: new Date(article.frontmatter.date).toISOString().slice(0, 10),
    description: article.frontmatter.description,
    tag: (article.frontmatter.tags ?? [])[0],
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 5);
---

<Base title="Home" description="Personal tech and thinking blog">
  <header class="hero">
    <div class="hero-shade"></div>
    <div class="hero-content">
      <p class="eyebrow">pathsoflight.org</p>
      <h1>Shiwenjie</h1>
      <p class="tagline">Building software, learning in public, and writing to think more clearly.</p>
      <div class="now">
        <span class="now-dot"></span>
        <p><span class="now-label">Now</span>Working on a small personal tooling project and refining my writing workflow.</p>
      </div>
    </div>
  </header>

  <main class="home">
    <section id="writing">
      <div class="section-head">
        <p class="section-label">Writing</p>
        <a class="all-posts" href="/writing">All posts →</a>
      </div>
      <div class="post-list">
        {articles.map((article) => (
          <a class="post-row" href={article.href}>
            <p class="post-date">{article.date}</p>
            <div class="post-body">
              <h2>{article.title}</h2>
              {article.description && <p class="post-desc">{article.description}</p>}
              {article.tag && <p class="post-tags"><span class="post-tag">{article.tag}</span></p>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="about" class="about">
      <div class="about-text">
        <p class="section-label">About</p>
        <p class="about-lead">I’m a developer who writes about technology, decision-making, and how ideas hold up in real work.</p>
        <p class="about-more">This blog is where I keep notes from projects, mistakes, and things I’m still trying to understand.</p>
      </div>
      <div class="photo-grid">
        <figure>
          <div class="photo"><img src="/images/tokyo-lantern.jpg" alt="Tokyo lantern scene" /></div>
          <figcaption>Tokyo — lantern</figcaption>
        </figure>
        <figure>
          <div class="photo"><img src="/images/tokyo-garden-window.jpg" alt="Tokyo garden window view" /></div>
          <figcaption>Tokyo — garden window</figcaption>
        </figure>
      </div>
    </section>

    <footer>
      <p>© 2026 Shiwenjie</p>
    </footer>
  </main>
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 78vh;
    background: url('/images/pexels-photo-3013999.jpeg') center 40% / cover no-repeat;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 14, 15, 0.55) 0%, rgba(14, 14, 15, 0.62) 55%, var(--bg) 100%);
  }

  .hero-content {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 8rem 2rem 4rem;
  }

  .eyebrow {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.6);
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .tagline {
    max-width: 34ch;
    margin-top: 1.25rem;
    font-size: 1.15rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
    text-wrap: pretty;
  }

  .now {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    max-width: 560px;
    margin-top: 2.25rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(14, 14, 15, 0.55);
    backdrop-filter: blur(8px);
  }

  .now p {
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .now-dot {
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--acc2);
    box-shadow: 0 0 0 4px rgba(93, 202, 165, 0.18);
  }

  .now-label {
    margin-right: 0.6rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--acc2);
  }

  .home {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 2rem 0;
  }

  #writing {
    padding-top: 2.5rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .section-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg2);
  }

  .all-posts {
    font-size: 0.8rem;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-row {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    margin: 0 -0.75rem;
    padding: 1.5rem 0.75rem;
    border-bottom: 1px solid var(--border);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
  }

  .post-row:hover {
    background: rgba(255, 255, 255, 0.035);
    text-decoration: none;
  }

  .post-date {
    padding-top: 0.15rem;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--fg2);
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .post-body h2 {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--fg);
    text-wrap: pretty;
  }

  .post-desc {
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--fg2);
    text-wrap: pretty;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .post-tag {
    padding: 0.1rem 0.5rem;
    border: 1px solid rgba(127, 119, 221, 0.35);
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--acc);
  }

  .about {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
    align-items: start;
    margin-top: 4.5rem;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-lead {
    font-size: 0.95rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .about-more {
    font-size: 0.88rem;
    line-height: 1.8;
    color: var(--fg2);
    text-wrap: pretty;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  figure {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .photo {
    overflow: hidden;
    border-radius: 12px;
  }

  .photo img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  figcaption {
    font-size: 0.72rem;
    color: var(--fg2);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 5rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--fg2);
  }

  @media (max-width: 720px) {
    .hero-content {
      padding: 7rem 1.25rem 3rem;
    }

    .home {
      padding: 1rem 1.25rem 0;
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
